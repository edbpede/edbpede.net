{
  "name": "edbpede-net",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Landing hub linking the edbpede.net subdomains.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bunx --bun astro dev",
    "build": "bunx --bun astro build",
    "preview": "bunx --bun astro preview",
    "check": "bunx --bun astro check",
    "lint": "bunx --bun biome check .",
    "lint:fix": "bunx --bun biome check --write .",
    "test:e2e": "bunx --bun playwright test"
  },
  "dependencies": {
    "astro": "7.2.6",
    "astro-icon": "1.2.0",
    "svelte": "5.56.10",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/svelte": "9.0.1",
    "@biomejs/biome": "2.5.10",
    "@iconify-json/mdi": "1.2.3",
    "@playwright/test": "1.62.1",
    "@swc/helpers": "0.5.23",
    "@types/bun": "1.4.0",
    "@unocss/astro": "66.8.1",
    "@unocss/reset": "66.8.1",
    "typescript": "5.9.3",
    "unocss": "66.8.1"
  }
}
